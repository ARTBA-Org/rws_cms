# PDF Processing Configuration
# =================================

# Processing limits
PDF_MAX_PAGES=10                    # Maximum pages to process per batch
PDF_TIMEOUT_MS=25000               # Timeout in milliseconds (25s for Lambda)
PDF_BATCH_SIZE=1                   # Number of pages to process in parallel

# Image generation
PDF_ENABLE_IMAGES=true             # Enable image generation from PDF pages
PDF_IMAGE_FORMAT=png               # Image format: png or webp
PDF_IMAGE_QUALITY=90               # Image quality (1-100)
PDF_IMAGE_DPI=300                  # Image resolution in DPI
PDF_MAX_IMAGE_DIMENSION=6000       # Maximum image width/height in pixels

# AI Analysis
PDF_ENABLE_AI=true                 # Enable AI-powered slide analysis
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano           # OpenAI model to use
PDF_AI_RETRY_ATTEMPTS=3           # Number of retry attempts for AI API calls

# Browser settings (Puppeteer)
PDF_PUPPETEER_RETRY_ATTEMPTS=2    # Number of retry attempts for browser operations
CHROME_HEADLESS=true              # Run Chrome in headless mode

# Browser Pool settings
BROWSER_POOL_MAX_INSTANCES=3      # Maximum browser instances in pool
BROWSER_POOL_MAX_PAGE_COUNT=10    # Pages per browser before restart (prevents memory leaks)
BROWSER_POOL_MAX_IDLE_TIME=300000 # Max idle time in milliseconds (5 minutes)
BROWSER_POOL_MAX_INSTANCE_AGE=1800000 # Max browser age in milliseconds (30 minutes)

# Caching (Redis - optional)
PDF_ENABLE_CACHING=false          # Enable Redis caching for processed slides
PDF_CACHE_EXPIRE_HOURS=24         # Cache expiration time in hours
REDIS_URL=redis://localhost:6379  # Redis connection URL (optional)

# Streaming processing
PDF_ENABLE_STREAMING=true         # Enable streaming processing for large PDFs
PDF_STREAM_CHUNK_SIZE=2           # Number of pages to process per streaming chunk

# Job Queue (BullMQ) - requires Redis
PDF_AUTO_START_WORKER=false       # Auto-start background worker
PDF_WORKER_CONCURRENCY=1          # Number of concurrent PDF processing jobs
REDIS_HOST=localhost              # Redis host for job queue
REDIS_PORT=6379                   # Redis port
REDIS_PASSWORD=                   # Redis password (optional)
REDIS_DB=0                        # Redis database number

# Your existing environment variables...
DATABASE_URI=your_database_uri
PAYLOAD_SECRET=your_payload_secret
# etc...