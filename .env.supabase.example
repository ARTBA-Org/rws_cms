# Supabase Configuration for Edge Functions PDF Processing
# Copy this to your .env.local file and fill in the values

# Supabase Project URL (RS+ Project)
NEXT_PUBLIC_SUPABASE_URL=https://nwquaemdrfuhafnugbgl.supabase.co

# Supabase Anonymous Key (for client-side requests)
# Get this from your Supabase dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for server-side requests with full access)
# Get this from your Supabase dashboard: Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For local development with Supabase CLI
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Enable/disable Edge Function processing (fallback to local processing if false)
PDF_USE_EDGE_FUNCTIONS=true

# Edge Function specific settings
EDGE_FUNCTION_TIMEOUT=120000
EDGE_FUNCTION_RETRY_ATTEMPTS=2
